\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textsc  {Aegis}\xspace  vulnerability ranking on the IEEE 14-bus benchmark (10-seed mean; P@10 $= 0.70$ for this run, consistent with the $0.74 \pm 0.12$ in \cref  {tab:ieee}). Bus markers encode physical bus type (slack / generator / load); green edges are the top-10 by $v_{ij}$ with rank tags ($\#1$--$\#3$); yellow midpoint dots mark edges that also appear in the brute-force N-1 top-10 ($7$ of $10$). Top-ranked edges concentrate on the high-flow inter-area tie lines (1--2, 1--5, 7--8), recovering the single-contingency severity pattern from one closed-form SVD pass.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ieee14_case}{{8}{9}{\AEGIS vulnerability ranking on the IEEE 14-bus benchmark (10-seed mean; P@10 $= 0.70$ for this run, consistent with the $0.74 \pm 0.12$ in \cref {tab:ieee}). Bus markers encode physical bus type (slack / generator / load); green edges are the top-10 by $v_{ij}$ with rank tags ($\#1$--$\#3$); yellow midpoint dots mark edges that also appear in the brute-force N-1 top-10 ($7$ of $10$). Top-ranked edges concentrate on the high-flow inter-area tie lines (1--2, 1--5, 7--8), recovering the single-contingency severity pattern from one closed-form SVD pass}{figure.caption.13}{}}
