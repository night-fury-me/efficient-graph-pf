\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces \textsc  {Aegis}\xspace  Vulnerability Analysis (matrix-free). Assumes the equilibrium $z^{*}$ is pre-computed on the analysis (sub)graph. Dense fallback ($N\!\leq \!200$): form $S\!=\!(I\!-\!J_z)^{-1}J_A$ and run a deterministic SVD in place of lines~2--11.}}{5}{algorithm.1}\protected@file@percent }
\newlabel{alg:aegis}{{1}{5}{\AEGIS Vulnerability Analysis (matrix-free). Assumes the equilibrium $\zstar $ is pre-computed on the analysis (sub)graph. Dense fallback ($N\!\leq \!200$): form $S\!=\!(I\!-\!J_z)^{-1}J_A$ and run a deterministic SVD in place of lines~2--11}{algorithm.1}{}}
